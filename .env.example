# Copy this file to .env.local and fill in values from Supabase → Project Settings → API.
# If these two public values are empty, the app stays in demo mode.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for Team → Invite emails. Never prefix with NEXT_PUBLIC_.
# Never paste this value into chat or the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only canonical app origin for invite emails. Leave empty locally.
# Production example: https://app.brandingcurve.agency
APP_ORIGIN=
